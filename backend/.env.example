# ==========================================
# Picksy Backend Environment Configuration
# ==========================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Supabase PostgreSQL + pgvector Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Admin API Key for Inventory CRUD Endpoints (/products)
ADMIN_API_KEY=your_secure_admin_api_key

# Port (Optional: Defaults to 8000 on EC2, 7860 on Hugging Face)
PORT=8000

# Allowed CORS Origins (Optional: Comma-separated list of allowed frontend domains or * for dev)
ALLOWED_ORIGINS=https://pickksy.vercel.app,http://localhost:3000
